rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public portfolio data can be read by any visitor
    match /portfolio/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // Default deny for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
